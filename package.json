{
  "name": "airforge",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Sketch ramps, balls, and platforms in the browser and simulate them with Rapier physics.",
  "author": "skysssup",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
